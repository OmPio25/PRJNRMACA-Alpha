{
  "name": "nextmitracareport",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi upload, pengelolaan, dan pelaporan Data Agent, Produksi, dan Claim Settled",
  "type": "commonjs",
  "main": "src/server/index.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
